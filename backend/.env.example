PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/smartspend?retryWrites=true&w=majority
JWT_SECRET=<generate-a-unique-random-secret-at-least-32-characters>
JWT_REFRESH_SECRET=<generate-a-different-random-secret-at-least-32-characters>
CLIENT_URL=http://localhost:5173
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
SCAN_STORAGE_DIR=private/scans
SCAN_RETENTION_DAYS=30
OCR_PROVIDER=google-vision
OCR_API_KEY=<optional-google-cloud-vision-api-key>
OCR_TIMEOUT_MS=15000
STATEMENT_STORAGE_DIR=private/statements
STATEMENT_RETENTION_DAYS=90
CATEGORIZATION_AI_PROVIDER=disabled
CATEGORIZATION_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
CATEGORIZATION_AI_API_KEY=
CATEGORIZATION_AI_MODEL=gpt-4o-mini
CATEGORIZATION_AI_TIMEOUT_MS=5000
ASK_SPART_AI_PROVIDER=disabled
ASK_SPART_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
ASK_SPART_AI_API_KEY=
GEMINI_API_KEY=
ASK_SPART_AI_MODEL=gemini-3-flash-preview
ASK_SPART_AI_TIMEOUT_MS=8000
ASK_SPART_MAX_TOKENS=400
